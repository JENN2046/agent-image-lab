{
  "name": "agent-image-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Local tooling for Agent Image Lab evidence capsules.",
  "type": "commonjs",
  "scripts": {
    "create-preview-capsule": "node scripts/create_preview_capsule.js",
    "validate-preview-capsule": "node scripts/validate_preview_capsule.js",
    "validate-preview-capsule-registry": "node scripts/validate_preview_capsule_registry.js",
    "validate-preview-capsule-negative-cases": "node scripts/validate_preview_capsule_registry_negative_cases.js",
    "create-preview-capsule:plan": "node scripts/create_preview_capsule.js",
    "create-preview-capsule:confirmed": "node scripts/create_preview_capsule.js --confirm-create=true",
    "validate:smoke": "node scripts/validate_smoke.js",
    "validate:mvp": "node scripts/validate_mvp_core.js",
    "validate:mvp-core": "node scripts/validate_mvp_core.js",
    "validate:readonly-visual-review-mvp": "node scripts/validate_readonly_visual_review_mvp.js",
    "validate:governance": "powershell -ExecutionPolicy Bypass -File scripts/validate_governance.ps1",
    "validate:legacy-mvp": "powershell -ExecutionPolicy Bypass -File scripts/validate_governance.ps1",
    "validate:governance-regression": "node scripts/validate_governance_regression.js",
    "validate:capsule-regression": "powershell -ExecutionPolicy Bypass -File scripts/validate_capsule_product_core_regression.ps1",
    "validate:capsules": "npm run validate:capsule-regression",
    "validate:all": "npm run validate:smoke && npm run validate:mvp && npm run validate:runtime-kernel && npm run validate:review-bridge-readonly && npm run validate:durable-audit-store && npm run validate:provider-preflight && npm run validate:exact-a5-provider-packet && npm run validate:exact-a5-provider-retry-packet && npm run validate:retry-007-preflight-decision && npm run validate:exact-a5-activation-receipt && npm run validate:exact-a5-retry-activation-receipt && npm run validate:exact-a5-retry-003-activation-receipt && npm run validate:exact-a5-retry-004-activation-receipt && npm run validate:exact-a5-retry-005-activation-receipt && npm run validate:exact-a5-retry-006-activation-receipt && npm run validate:retry-006-artifact-integrity && npm run validate:provider-evidence-integrity && npm run validate:capsule-regression && npm run validate:governance",
    "validate:core": "npm run validate:smoke && npm run validate:runtime-kernel && npm run validate:review-bridge-readonly && npm run validate:durable-audit-store && npm run validate:provider-preflight",
    "validate:review-console-static": "node scripts/validate_capsule_static_product_smoke_review_console_snapshot.js && node scripts/validate_review_console_static_mock_boundary.js",
    "preview:review-console": "node scripts/serve_review_console_static.js",
    "validate:public-disclosure-core": "node scripts/validate_public_repo_disclosure_audit.js",
    "validate:public-disclosure": "node scripts/validate_public_repo_disclosure_audit.js && node scripts/validate_tracked_local_path_config_detrack_execution_postcondition.js",
    "validate:runtime-kernel-gap": "node scripts/validate_runtime_kernel_backend_gap_map.js",
    "validate:runtime-kernel-audit": "node scripts/validate_runtime_kernel_v0_audit_write.js",
    "validate:runtime-kernel": "node scripts/validate_runtime_kernel_v0.js && npm run validate:runtime-kernel-audit",
    "validate:review-bridge-readonly": "node scripts/validate_runtime_review_bridge_readonly_stub.js",
    "validate:durable-audit-store": "node scripts/validate_runtime_durable_audit_store.js",
    "validate:provider-preflight": "node scripts/validate_provider_preflight_no_provider_call.js",
    "validate:exact-a5-provider-packet": "node scripts/validate_exact_a5_provider_execution_packet_draft.js",
    "validate:exact-a5-provider-retry-packet": "node scripts/validate_exact_a5_provider_retry_packet_draft.js",
    "validate:retry-007-preflight-decision": "node scripts/validate_exact_a5_provider_retry_007_preflight_decision.js",
    "validate:exact-a5-activation-receipt": "node scripts/validate_exact_a5_provider_execution_activation_receipt.js",
    "validate:exact-a5-retry-activation-receipt": "node scripts/validate_exact_a5_provider_retry_activation_receipt.js",
    "validate:exact-a5-retry-003-activation-receipt": "node scripts/validate_exact_a5_provider_retry_003_activation_receipt.js",
    "validate:exact-a5-retry-004-activation-receipt": "node scripts/validate_exact_a5_provider_retry_004_activation_receipt.js",
    "validate:exact-a5-retry-005-activation-receipt": "node scripts/validate_exact_a5_provider_retry_005_activation_receipt.js",
    "validate:exact-a5-retry-006-activation-receipt": "node scripts/validate_exact_a5_provider_retry_006_activation_receipt.js",
    "validate:retry-006-artifact-integrity": "node scripts/validate_retry_006_artifact_integrity.js",
    "validate:provider-evidence-integrity": "node scripts/validate_provider_evidence_integrity_contract.js",
    "validate:metadata-only-accepted-sample-retry-006": "node scripts/validate_metadata_only_accepted_sample_retry_006.js",
    "validate:runs-stewardship": "node scripts/validate_runs_backup_manifest_schema.js && node scripts/validate_runs_restore_report_dry_run_schema.js"
  },
  "dependencies": {
    "sharp": "0.33.5",
    "yaml": "^2.9.0"
  }
}
