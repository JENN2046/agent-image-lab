      ]
    },
    {
      "id": "metadata_only_accepted_sample_retry_006",
      "command": "node scripts/validate_metadata_only_accepted_sample_retry_006.js",
      "script": "scripts/validate_metadata_only_accepted_sample_retry_006.js",
      "tier": "targeted",
      "domain": "accepted_samples",
      "status": "active",
      "estimated_runtime_class": "fast",
      "trigger_paths": [
        "accepted_samples/**",
        "scripts/validate_metadata_only_accepted_sample_retry_006.js"
      ],
      "required_for": [
        "metadata_only_sample_patch"
      ]
    },
    {
      "id": "readonly_visual_review_mvp",
      "command": "node scripts/validate_readonly_visual_review_mvp.js",
      "script": "scripts/validate_readonly_visual_review_mvp.js",
      "tier": "mvp",
      "domain": "review_console",
      "status": "active",
      "estimated_runtime_class": "slow",
      "trigger_paths": [
        "review_console/static_prototype/**",
        "tests/schema_examples/readonly_visual_review_mvp_state.example.json",
        "tests/schema_examples/visual_eval_readonly_review_artifact_catalog.example.json",
        "tests/schema_examples/visual_eval_readonly_review_corpus_renderer.example.json",
        "tests/schema_examples/visual_eval_review_console_readonly_corpus_renderer_static_handoff.example.json",
        "docs/READONLY_VISUAL_REVIEW_MVP.md",
        "scripts/validate_readonly_visual_review_mvp.js"
      ],
      "required_for": [
        "review_console_mvp_patch",
        "mvp_core"
      ],
      "notes": "Phase 0 timing observed this as the largest MVP child cost because it nests readonly artifact system/catalog validators."
    },
    {
      "id": "governance",
      "command": "npm run validate:governance",
      "script": "scripts/validate_governance.ps1",
      "tier": "archive",
      "domain": "governance",
      "status": "active",
      "estimated_runtime_class": "slow",
      "trigger_paths": [
        "AGENTS.md",
        "AGENTS.autopilot-overlay.md",
        "scripts/validate_governance.ps1",
        "scripts/validate_mvp.ps1",
        "scripts/validators/autopilot_governance/**",
        "docs/**",
        ".agent_board/**"
