{
  "manifest_version": "local_visual_eval.robustness_manifest.v1",
  "contract": {
    "schema_version": "1.0.0",
    "decision_values": [
      "accepted",
      "rejected"
    ],
    "score_type": "integer",
    "score_range": {
      "min": 0,
      "max": 5
    },
    "score_fields": [
      "subject_fidelity",
      "composition",
      "lighting",
      "material_realism",
      "commercial_fitness"
    ],
    "unknown_top_level_field": "reject",
    "unknown_nested_field": "reject",
    "unknown_failure_code": "reject",
    "duplicate_failure_code": "reject",
    "unsupported_schema_version": "reject",
    "empty_correction_strategy": "reject",
    "declared_computed_decision_mismatch": "reject",
    "exit_codes": {
      "success": 0,
      "invalid_or_mismatch": 2,
      "internal_error": 1
    }
  },
  "cases": [
    {
      "case_id": "SCORE_FLOAT",
      "target": "sample",
      "base_ref": "fixtures/accepted.sample.json",
      "mutations": [
        {
          "type": "set",
          "path": [
            "review_scores",
            "subject_fidelity"
          ],
          "value": 4.5
        }
      ],
      "expected_valid": false,
      "expected_declared_decision": "accepted",
      "expected_computed_decision": "unknown",
      "expected_violation_codes": [
        "SCORE_FLOAT"
      ],
      "expected_violation_paths": [
        "$.review_scores.subject_fidelity"
      ]
    },
