        {
          "code": "PERSONAL_DATA_PATTERN_DETECTED",
          "path": "$.reviewer_alias"
        }
      ]
    },
    {
      "case_id": "NOTES_CONTAIN_EMAIL",
      "expected_violations": [
        {
          "code": "PERSONAL_DATA_PATTERN_DETECTED",
          "path": "$.sample.reviewer_notes.summary"
        }
      ]
    },
    {
      "case_id": "NOTES_CONTAIN_PHONE",
      "expected_violations": [
        {
          "code": "PERSONAL_DATA_PATTERN_DETECTED",
