{
  "regression_version": "local_visual_eval.human_review_import_regression.v1.4",
  "import_schema_version": "1.0.0",
  "assertion_contract": {
    "asserts": [
      "valid",
      "violations[].code",
      "violations[].path"
    ],
    "does_not_assert": [
      "violations[].message",
      "full stdout",
      "raw input value"
    ],
    "mutation_must_change_base_fixture": true,
    "no_disk_mutation": true
  },
  "required_cases": [
    {
      "case_id": "UNSUPPORTED_IMPORT_SCHEMA_VERSION",
      "expected_violations": [
        {
          "code": "UNSUPPORTED_IMPORT_SCHEMA_VERSION",
          "path": "$.import_schema_version"
        }
      ]
    },
    {
      "case_id": "UNKNOWN_IMPORT_TOP_LEVEL_FIELD",
      "expected_violations": [
        {
          "code": "UNKNOWN_IMPORT_FIELD",
          "path": "$.unexpected_field"
        }
      ]
    },
    {
      "case_id": "WRONG_RECORD_ORIGIN",
      "expected_violations": [
        {
          "code": "INVALID_RECORD_ORIGIN",
          "path": "$.record_origin"
        }
      ]
    },
    {
      "case_id": "HUMAN_ORIGIN_WITHOUT_SANITIZED_MARKER",
      "expected_violations": [
        {
          "code": "INVALID_RECORD_ORIGIN",
          "path": "$.record_origin"
        }
      ]
    },
    {
      "case_id": "WRONG_CONSENT_BASIS",
      "expected_violations": [
        {
          "code": "INVALID_CONSENT_BASIS",
          "path": "$.consent_basis"
        }
      ]
    },
    {
      "case_id": "RAW_SOURCE_RETAINED_TRUE",
      "expected_violations": [
        {
          "code": "RAW_SOURCE_RETENTION_FORBIDDEN",
          "path": "$.sanitization_attestation.raw_source_retained"
        }
      ]
    },
    {
      "case_id": "PERSONAL_DATA_ATTESTATION_TRUE",
      "expected_violations": [
        {
          "code": "SANITIZATION_ATTESTATION_FAILED",
          "path": "$.sanitization_attestation.contains_personal_data"
        }
      ]
    },
    {
      "case_id": "SECRET_ATTESTATION_TRUE",
      "expected_violations": [
        {
          "code": "SANITIZATION_ATTESTATION_FAILED",
          "path": "$.sanitization_attestation.contains_secret"
        }
      ]
    },
    {
      "case_id": "ABSOLUTE_PATH_ATTESTATION_TRUE",
